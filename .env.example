# Required — server refuses to start without this
JWT_SECRET=change_me_use_openssl_rand_hex_32

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mit_db

# Required for media uploads — must be public URL reachable by mobile clients
# Without this, uploaded photo URLs stored in DB will resolve to localhost and break on device
BASE_URL=https://api.yourdomain.com

# Optional — Google OAuth (token aud check skipped if absent)
GOOGLE_CLIENT_ID=

# Optional — defaults to 3000
PORT=3000

# Optional — affects logging behavior
NODE_ENV=development
