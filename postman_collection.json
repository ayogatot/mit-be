              "raw": "{{base_url}}/api/admin/:table",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", ":table"],
              "variable": [
                {
                  "key": "table",
                  "value": "interests",
                  "description": "Must be: genders, interests, relations, languages"
