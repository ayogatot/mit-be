            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meets/:id/requests/:requestId",
              "host": ["{{base_url}}"],
              "path": ["api", "meets", ":id", "requests", ":requestId"],
              "variable": [
                { "key": "id", "value": "<MEET_UUID>" },
                { "key": "requestId", "value": "<REQUEST_UUID>" }
              ]
            }
          },
          "response": []
