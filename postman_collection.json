              "raw": "{\n  \"name\": \"Updated Name\",\n  \"age\": 28,\n  \"job_title\": \"Software Engineer\",\n  \"zodiac\": \"Scorpio\",\n  \"about_me\": \"I love hiking and coffee.\",\n  \"looking_for\": \"Something serious\",\n  \"social_medias\": [{\"name\": \"Instagram\", \"value\": \"@myhandle\"}],\n  \"interests\": [\"<INTEREST_UUID_1>\", \"<INTEREST_UUID_2>\"],\n  \"languages\": [\"<LANGUAGE_UUID_1>\"],\n  \"relations\": [\"<RELATION_UUID_1>\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": ["{{base_url}}"],
              "path": ["api", "me"]
            }
          },
          "response": []
        },
