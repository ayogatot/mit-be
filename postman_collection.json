    {
      "name": "Messages",
      "item": [
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/messages/:matchId",
              "host": ["{{base_url}}"],
              "path": ["api", "messages", ":matchId"],
